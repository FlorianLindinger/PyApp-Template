#!/bin/sh
# Stops a push when the commits being pushed contain secrets or personal data.
# To use it in a clone: git config core.hooksPath code/backend/DONT_CHANGE/scripts/tools/git_hooks
# To push anyway, once: git push --no-verify

root="$(git rev-parse --show-toplevel)" || exit 1
launcher="$root/code/backend/DONT_CHANGE"

python=""
if [ -f "$launcher/tmp/runtime.cmd" ]; then
    python="$(sed -n 's/^set "PYAPP_PYTHON=\(.*\)"[[:space:]]*$/\1/p' "$launcher/tmp/runtime.cmd")"
fi
if [ -z "$python" ] || [ ! -x "$python" ]; then
    python="$(command -v python3 || command -v python || command -v py)"
fi
if [ -z "$python" ]; then
    echo "Leak check: no Python found, so the push was stopped. Run Setup, or push with --no-verify." >&2
    exit 1
fi

exec "$python" -B "$launcher/scripts/tools/check_git_leaks.py" --pushing
