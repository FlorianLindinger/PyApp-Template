# Git rules for code/backend. Paths starting with "/" are relative to this folder.

# uv project in env/: commit uv.lock and .python-version; pyproject.toml is
# generated from developer_settings.py and .venv is the app environment:
/env/pyproject.toml
/env/.venv/
/env/.venv.*/

# uv, Pythons and the uv cache when installed into the project:
/env/uv/
/env/uv.*/
/env/pythons/
/env/uv-cache/

# machine-specific list of generated shortcuts:
/shortcuts_created_by_setup.json

# The launcher folder is always tracked: this overrides every rule in the root .gitignore.
# Rules inside DONT_CHANGE/.gitignore still apply;
!/DONT_CHANGE/**
