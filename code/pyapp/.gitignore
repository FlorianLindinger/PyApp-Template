# Git rules for code/pyapp. Paths starting with "/" are relative to this folder.

# uv project in generated/: commit uv.lock and .python-version; pyproject.toml is
# generated from developer_settings.py and .venv is the app environment:
/generated/pyproject.toml
/generated/.venv/
/generated/.venv.*/

# uv, Pythons and the uv cache when installed into the project:
/generated/uv/
/generated/uv.*/
/generated/pythons/
/generated/uv-cache/

# machine-specific list of generated shortcuts:
/generated/shortcuts_created_by_setup.json

# The launcher folder is always tracked: this overrides every rule in the root .gitignore.
# Rules inside DONT_CHANGE/.gitignore still apply;
!/DONT_CHANGE/**
