# Git rules for code/pyapp. Leading "/" means relative to this folder.
# Keep source/settings/icons/tools/tests eligible for Git even if a parent ignores
# their extension or a subfolder. Later rules below exclude local artifacts again.
# Deeper .gitignore files still apply (DONT_CHANGE/tmp, test temp files, release zips).
# This cannot help if code/ or code/pyapp/ itself is excluded: unignore that ancestor
# in the parent .gitignore first. Inclusion does not automatically stage a file.
!/**/*

# Python bytecode and local package environments, anywhere below this folder.
__pycache__/
*.py[codz]
*$py.class
.Python
.venv/
venv/
venv.bak/
.conda/
.direnv/
__pypackages__/
site-packages/
node_modules/

# Local checker/test/editor caches.
.ruff_cache/
.pytest_cache/
.mypy_cache/
.pyre/
.pytype/
.dmypy.json
dmypy.json
cython_debug/
.ipynb_checkpoints/
.spyderproject
.spyproject
.ropeproject

# generated/ is local by default, including future runtime files, caches, staging
# folders and browser keys. Only these portable project files belong in Git.
# Ignore contents, not generated/ itself, so its file exceptions can take effect.
/generated/*
!/generated/README.md
!/generated/uv.lock
!/generated/.python-version
!/generated/auto_generated_icons.json

# Builds made by the compilation tools (large, and rebuilt from the code at any time).
/compiled/
