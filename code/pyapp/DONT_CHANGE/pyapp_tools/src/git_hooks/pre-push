#!/bin/sh
# Before a push: the leak check over the commits being pushed, the repository check, then
# verify_launcher (Ruff and Pyrefly) and the launcher's regression tests. verify_launcher and
# the tests check the files on disk, so changes that are not committed count too.
# To use it in a clone: git config core.hooksPath code/pyapp/DONT_CHANGE/pyapp_tools/src/git_hooks
# To push anyway, once: git push --no-verify

root="$(git rev-parse --show-toplevel)" || exit 1
launcher="$root/code/pyapp/DONT_CHANGE"

python=""
if [ -f "$launcher/tmp/runtime.cmd" ]; then
    python="$(sed -n 's/^set "PYAPP_PYTHON=\(.*\)"[[:space:]]*$/\1/p' "$launcher/tmp/runtime.cmd")"
fi
if [ -z "$python" ] || [ ! -x "$python" ]; then
    python="$(command -v python3 || command -v python || command -v py)"
fi
if [ -z "$python" ]; then
    echo 'Push blocked: Python was not found. Click "Show Command Output" for details.' >&2
    echo "Run Setup, then restart VS Code and try again." >&2
    echo "To bypass all push checks once: git push --no-verify" >&2
    exit 1
fi

# The same steps as check_all.bat (leak check, repository check, verify_launcher, tests),
# stopping at the first failure. The refs being pushed arrive on stdin, as Git gives them.
exec "$python" -B "$launcher/pyapp_tools/src/check_all.py" --pushing
