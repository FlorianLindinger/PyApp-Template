#!/bin/sh
# Before a push: the leak check over the commits being pushed, then verify_launcher (Ruff and
# Pyrefly) and the launcher's regression tests. verify_launcher and the tests check the files on
# disk, so changes that are not committed count too.
# To use it in a clone: git config core.hooksPath code/pyapp/DONT_CHANGE/pyapp_tools/src/git_hooks
# To push anyway, once: git push --no-verify

root="$(git rev-parse --show-toplevel)" || exit 1
launcher="$root/code/pyapp/DONT_CHANGE"

python=""
if [ -f "$launcher/tmp/runtime.cmd" ]; then
    python="$(sed -n 's/^set "PYAPP_PYTHON=\(.*\)"[[:space:]]*$/\1/p' "$launcher/tmp/runtime.cmd")"
fi
if [ -z "$python" ] || [ ! -x "$python" ]; then
    python="$(command -v python3 || command -v python || command -v py)"
fi
if [ -z "$python" ]; then
    echo "Leak check: no Python found, so the push was stopped. Run Setup, or push with --no-verify." >&2
    exit 1
fi

# Reads the refs being pushed from stdin, as Git gives them to this hook.
"$python" -B "$launcher/pyapp_tools/src/check_git_leaks.py" --pushing || exit 1

"$python" -B "$launcher/pyapp_tools/src/verify_launcher.py"
code=$?
if [ "$code" -eq 2 ]; then
    echo "verify_launcher skipped: Ruff or Pyrefly not found (put them on PATH, or install uv for uvx)." >&2
elif [ "$code" -ne 0 ]; then
    echo "Push stopped: the launcher failed verification (see above). To push anyway, once: git push --no-verify" >&2
    exit 1
fi

if ! "$python" -B -X utf8 "$launcher/tests/run_regressions.py" -q -j 0; then
    echo "Push stopped: launcher tests failed (see above). To push anyway, once: git push --no-verify" >&2
    exit 1
fi
