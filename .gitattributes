# Auto detect text files and perform LF normalization:
* text=auto
# Force git to use CRLF for batch files to not break them:
*.bat text eol=crlf
*.cmd text eol=crlf
# Git runs hooks with sh, which breaks on CRLF line endings:
code/backend/DONT_CHANGE/scripts/tools/git_hooks/* text eol=lf
# Keep Windows shortcuts byte-for-byte intact.
*.lnk binary
