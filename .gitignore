# Entries in this file will not be synchronized in git. 
# "*" represents any number of wildcard symbols.
# Use "/" to separate folder names in paths.
# Starting with "/" means the path is relative to this file.
# Use "**" to match any number of folders in a path.
# "!" before a line whitelists synchronization. Must come after rule that stops sync.
# Lines with "#" will be ignored.

# ============================
# ==== General gitignores ====
# ============================

# Spyder and Rope:
.spyderproject
.spyproject
.ropeproject
# Virtual environments and package environments:
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.conda/
.direnv/
__pypackages__/
# Linters, formatters and type checkers:
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
.dmypy.json
dmypy.json
cython_debug/
# cache from Python anywhere:
__pycache__/
*.pyc
*.pyo
*.py[codz]
*$py.class
.Python
# Keep generated files with local machine paths out of Git.
nuitka-crash-report.xml
**/bin/f2py.exe
**/bin/markdown-it.exe
**/bin/normalizer.exe
**/bin/pipreqs.exe
**/bin/pygmentize.exe
**/bin/pywin32_postinstall.exe
**/bin/pywin32_testall.exe
# Profiling results
*.lprof
*.prof
*.pstats
*.trace

# ===========================================
# ==== App framework specific gitignores ====
# ===========================================

# shortcuts in this folder:
/*.lnk
# contents of "logs" folder in this folder:
/logs/*
# contents of "crash logs" folder in this folder:
/crash logs/*
# temporary process id indicator files:
/code/*.pid
/code/*.pid.d/
/code/*.pid.lock
# uv icorn generated files in this folder:
/code/backend/frontend-python.lock.json
/code/backend/dev_tools/change python packages/DEFAULT_PYTHON_PACKAGES.txt.lock.json
# whitelist ".gitkeep" files anywhere:
!.gitkeep

# =================================
# ==== App specific gitignores ====
# =================================

# ADD THE GIT IGNORE SYNCING RULES FOR YOUR APP HERE

